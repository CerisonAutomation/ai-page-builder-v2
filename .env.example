# Supabase (Auth + DB + Storage + Realtime)
# Get these values from your Supabase project dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id-here.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here
SUPABASE_ANON_KEY=your-anon-key-here

# Postgres (via Supabase)
# Get connection strings from your Supabase project dashboard > Settings > Database
POSTGRES_URL=postgres://postgres.your-project-id-here:your-password@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
POSTGRES_PRISMA_URL=postgres://postgres.your-project-id-here:your-password@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
POSTGRES_URL_NON_POOLING=postgres://postgres.your-project-id-here:your-password@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgres://postgres.your-project-id-here:your-password@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Gemini AI
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-from-aistudio-google-com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Vercel AI Gateway (optional)
AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key
