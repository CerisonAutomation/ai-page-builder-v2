{
  "name": "ai-page-builder-v2",
  "version": "1.0.0",
  "description": "Production-grade AI-powered visual page builder with Puck + Gemini + Supabase",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:push": "drizzle-kit push:pg",
    "db:types": "supabase gen types --lang=typescript > types/supabase.ts",
    "db:seed": "node scripts/seed.js",
    "ai:inspector": "genkit start -- npm run dev",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:headed": "playwright test --headed"
  },
  "dependencies": {
    "@measured/puck": "^0.21.2",
    "@measured/puck-core": "^0.21.2",
    "@genkit-ai/googleai": "^0.5.0",
    "@genkit-ai/next": "^0.5.0",
    "@google/generative-ai": "^0.3.0",
    "genkit": "^0.5.0",
    "@supabase/supabase-js": "^2.43.0",
    "@supabase/ssr": "^0.4.0",
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "next-auth": "^4.24.11",
    "typescript": "^5.3.0",
    "zod": "^3.22.4",
    "react-hook-form": "^7.51.0",
    "@hookform/resolvers": "^3.3.4",
    "lucide-react": "^0.563.0",
    "sonner": "^1.3.1",
    "next-themes": "^0.2.1",
    "dompurify": "^3.0.6",
    "sharp": "^0.33.0",
    "drizzle-orm": "^0.30.9",
    "pg": "^8.11.3",
    "uuid": "^9.0.1",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/pg": "^8.11.6",
    "tailwindcss": "^3.4.1",
    "postcss": "^8.4.32",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "eslint-config-next": "^16.1.1",
    "prettier": "^3.1.1",
    "drizzle-kit": "^0.20.14",
    "@supabase/cli": "^1.167.9",
    "@playwright/test": "^1.40.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
