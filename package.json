    "@genkit-ai/next": "latest",
    "@google/generative-ai": "latest",
    "genkit": "latest",
    "@supabase/supabase-js": "latest",
    "@supabase/ssr": "latest",
    "next": "latest",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "latest",
    "zod": "latest",
    "lucide-react": "latest",
    "sonner": "latest",
    "uuid": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@playwright/test": "latest",
    "prettier": "latest"
  }
}
