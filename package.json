{
  "name": "ai-page-builder-v2",
  "version": "1.0.0",
  "description": "Production-grade AI-powered visual page builder with Puck + Gemini + Supabase",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:seed": "node scripts/seed.js",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "test": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "@measured/puck": "latest",
